{
  "name": "wizzy-battle-simulator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A two-player, turn-based wizard card game prototype.",
  "scripts": {
    "dev": "node scripts/serve.js",
    "start": "node scripts/serve.js",
    "build": "node scripts/build.js",
    "build:web": "node scripts/build.js --web",
    "build:production": "node scripts/build.js --web --game-only",
    "optimize:art": "python scripts/optimize-art.py",
    "deploy:pages": "npm test && npm run build:production && node scripts/deploy-pages.js --publish",
    "preview": "node scripts/serve.js dist",
    "multiplayer": "node server/index.js",
    "test": "node --test --test-isolation=none test/*.test.js"
  },
  "engines": { "node": ">=24" }
}
